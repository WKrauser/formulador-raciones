{
  "name": "formulador-raciones",
  "private": true,
  "version": "1.0.0",
  "description": "Formulación de raciones para animales a costo mínimo",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "data:scrape": "python3 tools/scrape_ft.py tools/sources/feedtables_raw.json",
    "data": "python3 tools/build_data.py",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:dev": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win nsis portable --x64 --publish never",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "dist:win:zip": "vite build && electron-builder --win zip --x64 --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.8",
    "highs": "^1.15.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.formulador.raciones",
    "productName": "Formulador de raciones",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icon-512.png",
      "artifactName": "Formulador-${version}-windows-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Formulador-${version}-instalador.${ext}"
    },
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "portable": {
      "artifactName": "Formulador-${version}-portable.${ext}"
    }
  },
  "author": "Formulador"
}